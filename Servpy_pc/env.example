# Segurança
SECRET_KEY=sua_chave_secreta_aqui_minimo_32_chars

# Banco de Dados (SQLite padrão, ou PostgreSQL/MySQL em prod)
DATABASE_URL=sqlite:///diervick.db

# Ambiente
FLASK_ENV=production
HTTPS=1
PORT=5000

# Origens CORS (separadas por vírgula)
ALLOWED_ORIGINS=https://app.diervick.com,http://localhost:5000

# API Google Gemini (Gratuita - https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL=gemini-2.0-flash

# Fallback OpenRouter (Gratuita - https://openrouter.ai/keys)
OPENROUTER_API_KEY=sua_chave_openrouter_aqui
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# Cache (SimpleCache para dev, RedisCache para prod)
CACHE_TYPE=SimpleCache
REDIS_URL=redis://localhost:6379/0

# Rate Limit
RATELIMIT_STORAGE_URI=memory://

# Diretórios
UPLOAD_FOLDER=/caminho/para/storage
